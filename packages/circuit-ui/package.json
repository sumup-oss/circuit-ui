{
  "name": "@sumup-oss/circuit-ui",
  "version": "12.0.0-next.10",
  "description": "SumUp's React UI component library",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "default": "./dist/legacy.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "default": "./dist/experimental.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "typesVersions": {
    "*": {
      "legacy": [
        "./dist/legacy.d.ts"
      ],
      "experimental": [
        "./dist/experimental.d.ts"
      ],
      "internal": [
        "./dist/internal.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "directory": "packages/circuit-ui",
    "url": "git+https://github.com/sumup-oss/circuit-ui.git"
  },
  "publishConfig": {
    "provenance": true
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/sumup-oss/circuit-ui/issues"
  },
  "homepage": "https://github.com/sumup-oss/circuit-ui/tree/main/packages/circuit-ui/README.md",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && rm -rf dist/node_modules",
    "lint": "foundry run eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest"
  },
  "dependencies": {
    "@sumup-oss/illustrations": "^1.1.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@nanostores/react": "^1.1.0",
    "nanostores": "^1.5.2"
  },
  "devDependencies": {
    "@sumup-oss/icons": "^7.0.0-next.4",
    "@sumup-oss/intl": "^3.5.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jest-axe": "^11.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-swipeable": "^7.0.2",
    "temporal-polyfill": "^1.0.4",
    "typescript": "^6.0.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@sumup-oss/design-tokens": ">=11.0.0-next.0",
    "@sumup-oss/icons": ">=7.0.0-next.0",
    "@sumup-oss/intl": "^3.1.1",
    "@sumup-oss/illustrations": "^1.0.0",
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0",
    "temporal-polyfill": ">=0.2.0 <2.0.0"
  },
  "engines": {
    "node": ">=24",
    "typescript": ">=4.1"
  }
}
