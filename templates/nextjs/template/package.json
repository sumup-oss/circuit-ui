{
  "name": "next-app",
  "version": "2.0.3-next.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "build:analyze": "ANALYZE=true npm run build",
    "start": "next start",
    "lint": "biome check --diagnostic-level=error && eslint . --quiet --concurrency=auto",
    "lint:fix": "biome check --write --diagnostic-level=error && eslint . --quiet --concurrency=auto --fix",
    "lint:css": "stylelint '**/*.css' --quiet",
    "test": "jest --watch",
    "test:ci": "mkdir -p __reports__ && jest --ci --coverage --runInBand --json --outputFile=__reports__/jest-results.json --reporters default --reporters \"github-actions\""
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.3.3",
    "@sumup-oss/circuit-ui": "^12.0.0",
    "@sumup-oss/design-tokens": "^11.0.0",
    "@sumup-oss/icons": "^7.0.0",
    "@sumup-oss/intl": "^3.5.1",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.3",
    "@sumup-oss/eslint-plugin-circuit-ui": "^8.0.0",
    "@sumup-oss/foundry": "^10.1.0",
    "@sumup-oss/stylelint-plugin-circuit-ui": "^5.0.0-next.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-testing-library": "^7.16.2",
    "jest": "^30.5.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.0",
    "typescript": "^6.0.3",
    "typescript-plugin-css-modules": "^5.2.0"
  },
  "overrides": {
    "@sumup-oss/foundry": {
      "@sumup-oss/stylelint-plugin-circuit-ui": "$@sumup-oss/stylelint-plugin-circuit-ui"
    }
  }
}
